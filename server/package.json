{
  "name": "school-lms-server",
  "version": "1.0.0",
  "description": "School LMS Express API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "ai:index": "ts-node src/setupTutorIndex.ts",
    "ai:prepare": "ts-node src/prepareTutorMaterials.ts",
    "start": "node dist/index.js",
    "seed": "ts-node src/seed.ts",
    "seed:student": "ts-node src/seedStudent.ts",
    "bootstrap:admin": "ts-node src/bootstrapAdmin.ts",
    "test": "node --test -r ts-node/register tests/*.test.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.4",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.14",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.33.4",
    "socket.io": "^4.8.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}

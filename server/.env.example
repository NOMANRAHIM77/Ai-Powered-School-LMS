NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Course tutor: Groq answers + free local multilingual embeddings.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
AI_VECTOR_INDEX=course_content_local_v1

MONGODB_URI=mongodb://127.0.0.1:27017/educore_lms
JWT_ACCESS_SECRET=replace-with-a-secure-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-secure-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=School LMS <noreply@schoollms.com>

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

SCHOOL_NAME=Bright Future Academy
SCHOOL_ADDRESS=123 Education Road, Karachi
SCHOOL_PHONE=+92-21-12345678
SCHOOL_EMAIL=info@school.edu

# Optional: unique development-only password for npm run seed:student
SEED_STUDENT_PASSWORD=

# Set these locally before running npm run bootstrap:admin.
ADMIN_BOOTSTRAP_NAME=School Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
